#!/usr/bin/env bash
# Keep development CLI data separate from production.
set -euo pipefail

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
CLI_ENTRY="$REPO_ROOT/out/cli/index.js"

if [ ! -f "$CLI_ENTRY" ]; then
  echo "madang-dev: CLI not built yet. Run 'pnpm run build:cli' first." >&2
  exit 1
fi

case "$(uname -s)" in
  Darwin)       default_data="$HOME/Library/Application Support/madang-dev" ;;
  MINGW*|MSYS*) default_data="${APPDATA:-$HOME/AppData/Roaming}/madang-dev" ;;
  *)            default_data="${XDG_CONFIG_HOME:-$HOME/.config}/madang-dev" ;;
esac

export MADANG_USER_DATA_PATH="${MADANG_DEV_USER_DATA_PATH:-$default_data}"
electron_executable="$REPO_ROOT/node_modules/.bin/electron"
case "$(uname -s)" in
  MINGW*|MSYS*) electron_executable="$REPO_ROOT/node_modules/electron/dist/electron.exe" ;;
esac
if [ -z "${MADANG_APP_EXECUTABLE:-}" ] && [ -x "$electron_executable" ]; then
  export MADANG_APP_EXECUTABLE="$electron_executable"
  export MADANG_APP_EXECUTABLE_NEEDS_APP_ROOT=1
fi
exec node "$CLI_ENTRY" "$@"
